# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=spotify_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── App ─────────────────────────────────────────────────────────────────────
APP_PORT=9000

# TTL cache untuk endpoint read-heavy (list artist, detail album).
# Format durasi Go: 30s, 5m, 2h.
CACHE_TTL=5m

# ─── JWT ─────────────────────────────────────────────────────────────────────
# WAJIB diisi — aplikasi menolak start kalau kosong.
# Pakai dua secret BERBEDA untuk access dan refresh token: kalau salah satu
# bocor, token jenis lain tidak otomatis bisa dipalsukan.
#
# Generate (Git Bash):   openssl rand -base64 32
# Generate (PowerShell):
#   $b=[byte[]]::new(32);[System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b)
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Masa berlaku token reset password.
RESET_TOKEN_TTL=15m

# ─── SMTP (email reset password) ──────────────────────────────────────────────
# Kalau SMTP_HOST DIBIARKAN KOSONG, aplikasi tetap jalan dan memakai LogMailer:
# isi email dicetak ke terminal, bukan dikirim. Cukup untuk development.
#
# Untuk kirim email sungguhan, contoh pakai Mailtrap (gratis untuk dev):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# starttls (default, port 587/2525) | ssltls (port 465) | none (MailHog lokal)
SMTP_ENCRYPTION=starttls

SMTP_FROM_EMAIL=noreply@spotifyclone.dev
SMTP_FROM_NAME=Spotify Clone

# ─── Frontend ────────────────────────────────────────────────────────────────
# Dipakai untuk menyusun link reset password di email.
FRONTEND_URL=http://localhost:5173

# Origin yang boleh memanggil API ini dari browser, dipisah koma.
# Default (kalau dikosongkan): http://localhost:5173,http://localhost:3000
#   5173 = Vite dev server, 3000 = frontend versi Docker demo
#
# TIDAK BOLEH diisi '*' — aplikasi menolak start. Wildcard dilarang oleh
# spesifikasi CORS ketika AllowCredentials aktif, karena kalau diizinkan, situs
# mana pun bisa mengirim request ber-kredensial ke API ini dan membaca hasilnya.
# Saat deploy, isi dengan domain produksi: https://spotifyclone.dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
